{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },

  "modules": [
    "title",
    {
      "type": "separator",
      "string": "──────────────────────────────"
    },

    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "󰔚 OS Age",
      "format": "{days} days"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },

    "break",

    {
      "type": "de",
      "key": "󰧨 Desktop"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons"
    },

    "break",

    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    {
      "type": "terminalfont",
      "key": "󰛖 Term Font"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "temp": false
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap"
    },

    "break",

    {
      "type": "disk",
      "key": "󰋊 Root",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
